---
import Layout from '../components/Layout.astro';
import PropertyCard from '../components/PropertyCard.astro';
import { getBiens } from '../lib/api.js';

const biens = await getBiens();
---
<Layout
	title="Vendre votre bien à Saint-Julien-en-Genevois à 2% — Ambassadeur Immo"
	description="Ambassadeur immobilier à Saint-Julien-en-Genevois, Annemasse, Viry. Vendez à 2% d'honoraires avec Bkeys. Eric — 06 60 56 02 00."
>
	<!-- Hero style LUXEVIA : clair, titre serif, badge, CTAs -->
	<section id="accueil" class="hero-luxe" style="background-image:url('https://ambassadeur-immo.com/wp-content/uploads/2026/08/photo-villa-home-blanc.jpg');">
		<div class="hero-luxe-overlay"></div>
		<div class="hero-luxe-inner">
			<span class="hero-luxe-badge"><span class="dot"></span>L'immobilier à 2 % d'honoraires</span>
			<h1 class="hero-luxe-titre">Trouvez votre<br /><em>bien idéal</em></h1>
			<p class="hero-luxe-pitch">
				Biens sélectionnés à Saint-Julien, Annemasse, Thonon et alentours.<br />
				Estimation Bkeys, diffusion réseau national, visites accompagnées —<br class="only-desktop" />
				vous restez maître de votre vente.
			</p>
			<div class="hero-luxe-cta">
				<a href="#nos-biens" class="cta-dark">Voir nos biens <span class="cta-arrow">→</span></a>
				<a href="#contact" class="cta-ghost"><span class="cta-play">▸</span>Contactez-moi</a>
			</div>
		</div>
	</section>

	<!-- À propos — éditeur -->
	<section id="pourquoi-moi" class="section ap-section">
		<div class="ap-visual">
			<img src="https://ambassadeur-immo.com/wp-content/uploads/2026/05/ERIC-PROFIL.jpeg" alt="Eric" class="about-photo" />
			<div class="ap-float-card">
				<b>Éric</b>
				<span>Ambassadeur Bkeys<br />Saint-Julien · Annemasse · Chablais</span>
			</div>
		</div>
		<div class="ap-text">
			<p class="eyebrow-l">— QUI SUIS-JE</p>
			<h2>Pas un agent.<br /><em>Un ambassadeur de confiance.</em></h2>
			<p class="ap-para">
				Je suis Éric, votre Ambassadeur <strong>Bkeys</strong> à Saint-Julien-En-Genevois, Annemasse et alentours.
			</p>
			<p class="ap-para">
				Je suis votre interlocuteur local : je vous présente l'estimation réalisée par <strong>Bkeys</strong>,
				j'ouvre la porte aux acquéreurs pour les visites, et <strong>Bkeys</strong> s'occupe de toute la partie
				<span class="u-underline">transaction</span>. Vous restez maître de votre vente.
			</p>
			<ul class="ap-points">
				<li><span class="ap-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m4.5 12.5 5 5 10-11"/></svg></span>Interlocuteur unique, joignable</li>
				<li><span class="ap-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m4.5 12.5 5 5 10-11"/></svg></span>Estimation et mandats portés par la plateforme Bkeys</li>
				<li><span class="ap-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m4.5 12.5 5 5 10-11"/></svg></span>Visites organisées pour vous — j'ouvre la porte et je vous accompagne</li>
			</ul>
		</div>
	</section>

	<!-- Pourquoi Bkeys — panneau sombre -->
	<section id="bkeys" class="section">
		<div class="bk-panel">
			<p class="eyebrow-l eyebrow-light">— NOTRE DIFFÉRENCE</p>
			<h2 class="bk-title">Pourquoi Bkeys plutôt qu'<em>une agence traditionnelle</em> ?</h2>
			<div class="bk-cards">
				<div class="bk-card">
					<div class="bk-num">2<span>%</span></div>
					<h3>Taux d'honoraires</h3>
					<p>Vendez votre bien avec des honoraires 2 à 3 fois moins chers qu'une agence classique. Vous gardez d'avantage de valeur sur votre vente, sans compromis sur le service.</p>
					<p class="bk-vs">vs 5 à 7 % en agence traditionnelle</p>
				</div>
				<div class="bk-card bk-card-accent">
					<div class="bk-num">1<span>clic</span></div>
					<h3>Mandat Bkeys résiliable</h3>
					<p>Aucun engagement contraignant. Notre mandat est résiliable instantanément depuis votre espace personnel. Vous restez libre, à tout moment.</p>
					<p class="bk-vs">vs mandats exclusifs longue durée en agence</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Étapes — timeline -->
	<section id="vente" class="section steps-wrap">
		<p class="eyebrow-l">— VOUS VENDEZ ?</p>
		<h2 class="h2-center">De l'estimation <em>à la signature</em></h2>
		<p class="h2-sub">4 étapes, un service complet avec seulement 2 % d'honoraires</p>
		<div class="steps-trail">
			<div class="trail-line"></div>
			<div class="step-t">
				<div class="step-n">01</div>
				<h3>Estimation gratuite</h3>
				<p>Je vous accompagne pour obtenir une estimation via la plateforme Bkeys.</p>
			</div>
			<div class="step-t">
				<div class="step-n">02</div>
				<h3>Diffusion réseau national</h3>
				<p>Votre bien publié sur la plateforme Bkeys et son réseau national d'acquéreurs qualifiés.</p>
			</div>
			<div class="step-t">
				<div class="step-n">03</div>
				<h3>Visites accompagnées</h3>
				<p>J'organise les visites pour le compte du vendeur.</p>
			</div>
			<div class="step-t">
				<div class="step-n">04</div>
				<h3>Suivi jusqu'à la vente</h3>
				<p>Bkeys assure le suivi administratif jusqu'à la signature.</p>
			</div>
		</div>
	</section>

	<!-- Achat -->
	<section id="achat" class="section">
		<p class="eyebrow-l">— VOUS CHERCHEZ UN BIEN ?</p>
		<h2 class="h2-center">Trouvez votre bien idéal, <em>en toute sécurité</em></h2>
		<p class="h2-sub">Consultez les biens disponibles sur la plateforme Bkeys. Je vous fais visiter localement, Bkeys encadre la transaction.</p>
		<div class="achat-cards">
			<div class="achat-card">
				<span class="achat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></span>
				<h3>Recherche sur mesure</h3>
				<p>Je vous mets en relation avec des biens disponibles sur la plateforme Bkeys.</p>
			</div>
			<div class="achat-card">
				<span class="achat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M9 7h2m2 0h2M9 11h2m2 0h2M9 15h2m2 0h2"/><path d="M10.5 21v-3h3v3"/></svg></span>
				<h3>Plateforme Bkeys sécurisée</h3>
				<p>Processus 100 % sécurisé et transparent.</p>
			</div>
			<div class="achat-card">
				<span class="achat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-8 8H4l2.3-2.9A8 8 0 1 1 21 12Z"/></svg></span>
				<h3>Visites accompagnées</h3>
				<p>Je vous accompagne pour chaque visite, jusqu'à votre décision.</p>
			</div>
		</div>
		<div class="achat-cta">
			<a href="#contact" class="cta-dark">Décrire mon projet d'achat <span class="cta-arrow">→</span></a>
		</div>
	</section>

	<!-- Biens en vente -->
	<section id="nos-biens" class="section">
		<div class="nosbiens-head">
			<div>
				<p class="eyebrow-l">— NOS BIENS</p>
				<h2 id="biens-titre">Nos biens en ventes <em>chez Bkeys</em></h2>
			</div>
			<p id="biens-vide" class="h2-sub" style="display:none;">Aucun bien ne correspond à ces critères pour le moment — <a href="#contact">décrivez votre recherche</a> et je vous tiens informé dès qu'un bien arrive.</p>
			<div class="nosbiens-side">
				<a href="tel:0660560200" class="cta-ghost"><span class="cta-play">▸</span>06 60 56 02 00</a>
			</div>
		</div>
		<div class="biens-grid" id="biens-grid">
			{biens.map((bien) => <PropertyCard bien={bien} />)}
		</div>
	</section>

	<!-- Contact — bannière sombre -->
	<section id="contact" class="section contact-wrap">
		<div class="contact-panel">
			<div class="contact-left">
				<h2>Une question ?<br /><em>Un projet de vente ?</em></h2>
				<p>Je suis disponible pour répondre à toutes vos questions — de vive voix ou par message.</p>
			</div>
			<div class="contact-right">
				<form id="home-lead-form" class="home-lead-form" autocomplete="off">
					<input type="text" name="website" class="hp-field" tabindex="-1" aria-hidden="true" />
					<input name="nom" placeholder="Votre nom" required />
					<input name="contact" placeholder="Téléphone ou email" required />
					<textarea name="message" rows="3" placeholder="Votre projet : vente, achat, estimation…"></textarea>
					<button type="submit">Envoyer <span class="cta-arrow">→</span></button>
					<p class="home-lead-feedback" id="home-lead-feedback"></p>
				</form>
				<div class="contact-phone-row">
					<a href="tel:0660560200" class="contact-phone-btn">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l1.5 4.5L8 10a13 13 0 0 0 6 6l1.5-2.5L20 15v4a1.5 1.5 0 0 1-1.6 1.5C9.6 19.9 4.1 14.4 3.5 5.6A1.5 1.5 0 0 1 5 4Z"/></svg>
						06 60 56 02 00
					</a>
					<div class="contact-social">
						<a href="https://www.facebook.com/bkeyshautesavoie" target="_blank" rel="noopener noreferrer">Facebook</a>
						<a href="https://www.instagram.com/bkeys_eric/" target="_blank" rel="noopener noreferrer">Instagram</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<script>
		const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:4000';
		// Formulaire d'info générique (projet vente/achat) -> /api/leads (bienId null)
		const hlf = document.getElementById('home-lead-form');
		if (hlf) {
			hlf.addEventListener('submit', async (e) => {
				e.preventDefault();
				const data = Object.fromEntries(new FormData(hlf).entries());
				// champ contact unique : on devine email vs téléphone
				const payload = {
					nom: data.nom,
					message: data.message || null,
					website: data.website || undefined,
					bienId: null,
					...(String(data.contact || '').includes('@')
						? { email: data.contact }
						: { tel: data.contact }),
				};
				if (payload.website) { return; }
				const fb = document.getElementById('home-lead-feedback');
				const btn = hlf.querySelector('button[type="submit"]');
				btn.disabled = true;
				const res = await fetch(API_URL + '/api/leads', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload),
				});
				btn.disabled = false;
				if (res.ok) {
					fb.textContent = 'Merci ! Votre demande a bien été envoyée.';
					fb.classList.add('is-ok');
					hlf.reset();
				} else {
					const err = await res.json().catch(() => ({}));
					fb.textContent = err.error || 'Une erreur est survenue.';
				}
			});
		}
	</script>
		// Filtre instantané de la grille depuis la barre de recherche du hero
		const search = document.getElementById('hero-search');
		if (search) {
			search.addEventListener('submit', (e) => {
				e.preventDefault();
				const t = document.getElementById('gs-type').value.toLowerCase();
				const c = document.getElementById('gs-categ').value;
				const z = document.getElementById('gs-zone').value.toLowerCase();
				const minCh = Number(document.getElementById('gs-chambres').value) || 0;
				let visible = 0;
				for (const card of document.querySelectorAll('#biens-grid .immo-card')) {
					const type = (card.dataset.type || '').toLowerCase();
					const categ = card.dataset.categorie || '';
					const ville = (card.dataset.ville || '').toLowerCase();
					const ch = Number(card.dataset.chambres || 0);
					const ok = (!t || type.includes(t)) && (!c || categ === c) && (!z || ville.includes(z)) && (!minCh || ch >= minCh);
					card.style.display = ok ? '' : 'none';
					if (ok) visible++;
				}
				const titre = document.getElementById('biens-titre');
				const filtres = [t && 'type ' + t, c && (c === 'neuf' ? 'neuf' : 'ancien'), z && z, minCh && minCh + '+ chambres'].filter(Boolean);
				if (titre) titre.innerHTML = filtres.length
					? `Biens <em>${filtres.join(' · ')}</em> <span style="color:#777;font-weight:400">(${visible})</span>`
					: 'Nos biens en ventes <em>chez Bkeys</em>';
				const vide = document.getElementById('biens-vide');
				if (vide) vide.style.display = visible ? 'none' : '';
				document.getElementById('nos-biens').scrollIntoView({ behavior: 'smooth' });
			});
		}
	</script>
</Layout>
