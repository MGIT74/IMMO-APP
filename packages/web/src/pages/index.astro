---
import Layout from '../components/Layout.astro';
import PropertyCard from '../components/PropertyCard.astro';
import { getBiens } from '../lib/api.js';

const biens = await getBiens();
---
<Layout title="Nos biens en vente">
	<div class="container">
		<h1 class="page-title">Nos biens en vente</h1>
		{biens.length === 0 ? (
			<p>Aucun bien pour le moment.</p>
		) : (
			<div class="biens-grid">
				{biens.map((bien) => <PropertyCard bien={bien} />)}
			</div>
		)}
	</div>
</Layout>
