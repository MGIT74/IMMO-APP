---
import Layout from '../components/Layout.astro';
import { getBiens } from '../lib/api.js';
const biens = await getBiens();
const euros = (n) => Number(n || 0).toLocaleString('fr-FR') + ' €';
---
<Layout title="Tous les biens — Ambassadeur Immo" description="Découvrez nos biens immobiliers sur une carte interactive.">
  <main class="catalog">
    <div class="catalog-heading">
      <div><p class="overline">AMBASSADEUR IMMO / SÉLECTION IMMOBILIÈRE</p><h1>Tous les biens</h1><p class="subheading"><span id="count">{biens.length}</span> biens disponibles dans notre sélection</p></div>
      <div class="view-switch" aria-label="Mode d'affichage"><button id="split-view" class="selected" type="button">Carte + liste</button><button id="grid-view" type="button">Grille</button></div>
    </div>
    <div class="catalog-filters">
      <label class="search-field"><span>⌕</span><input id="search" type="search" placeholder="Ville, code postal ou nom du bien…" aria-label="Rechercher un bien" /></label>
      <select id="type" aria-label="Type de bien"><option value="">Tous les types</option>{[...new Set(biens.map(b=>b.type).filter(Boolean))].map(t=><option value={t}>{t}</option>)}</select>
      <select id="budget" aria-label="Budget maximum"><option value="">Tous les budgets</option><option value="250000">250 000 € max</option><option value="500000">500 000 € max</option><option value="800000">800 000 € max</option><option value="1500000">1 500 000 € max</option></select>
      <button type="button" id="reset">Effacer les filtres</button>
    </div>
    <div class="catalog-layout" id="catalog-layout">
      <section class="results" aria-label="Liste des biens">
        <div class="results-top"><strong>Biens à découvrir</strong><span id="results-count">{biens.length} résultats</span></div>
        <div class="cards" id="cards">
          {biens.map((bien) => <a class="property" href={`/biens/${bien.id}`} data-id={bien.id} data-ville={bien.ville || ''} data-postal={bien.codePostal || ''} data-title={bien.titre || ''} data-type={bien.type || ''} data-prix={bien.prix || 0}>
            <div class="property-image">
              {bien.photos?.[0]?.url ? <img src={bien.photos[0].url} alt={bien.titre || 'Photo du bien'} loading="lazy" /> : <div class="no-image">Photo indisponible</div>}
              {bien.photos?.length > 1 && <span class="photo-count">▣ {bien.photos.length}</span>}
              {bien.etatTexte && <span class="status">{bien.etatTexte}</span>}
            </div>
            <div class="property-info">
              <p class="property-location">{bien.ville}{bien.codePostal ? ` · ${bien.codePostal}` : ''}</p>
              <h2>{bien.titre}</h2>
              <strong class="price">{euros(bien.prix)}</strong>
              <div class="features">{bien.surface && <span>{bien.surface} m²</span>}{bien.pieces && <span>{bien.pieces} pièces</span>}{bien.chambres && <span>{bien.chambres} chambres</span>}</div>
              <span class="details">Voir le bien <span aria-hidden="true">↗</span></span>
            </div>
          </a>)}
        </div>
        <p class="empty" id="empty" hidden>Aucun bien ne correspond à votre recherche.</p>
      </section>
      <section class="map-panel" aria-label="Carte des biens">
        <div id="map" role="region" aria-label="Carte interactive des biens immobiliers"></div>
        <div class="map-note" id="map-note">Chargement de la carte…</div>
      </section>
    </div>
    <button type="button" id="mobile-toggle" class="mobile-toggle">Afficher la carte</button>
  </main>
</Layout>
<style>
  :global(body){background:#fff;color:#141414}
  .catalog{max-width:1760px;margin:0 auto;padding:36px 34px 60px;font-family:inherit}
  .catalog-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:26px}
  .overline{font-size:11px;letter-spacing:.18em;font-weight:750;color:#777;margin:0 0 12px}
  h1{font-size:clamp(32px,3.1vw,48px);letter-spacing:-.045em;margin:0 0 8px;font-weight:750}
  .subheading{color:#777;margin:0;font-size:14px}
  .view-switch{background:#f4f4f4;border-radius:30px;padding:5px;display:flex;gap:4px}
  .view-switch button{border:0;background:transparent;padding:11px 17px;border-radius:24px;cursor:pointer;color:#555;font-weight:650}
  .view-switch button.selected{background:#141414;color:white}
  .catalog-filters{display:flex;gap:12px;align-items:center;margin-bottom:24px;flex-wrap:wrap}
  .catalog-filters select,.catalog-filters button,.search-field{background:#f6f6f6;border:1px solid #ededed;border-radius:13px;min-height:48px;padding:0 16px;color:#222;font:inherit;font-size:14px}
  .search-field{display:flex;align-items:center;gap:10px;flex:1;min-width:230px}
  .search-field span{font-size:24px}
  .search-field input{border:0;outline:0;background:transparent;width:100%;font:inherit;min-width:0}
  .catalog-filters button{cursor:pointer;background:white}
  .catalog-layout{display:grid;grid-template-columns:minmax(0,45fr) minmax(0,55fr);gap:24px;align-items:start}
  .results-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
  .results-top strong{font-size:18px}.results-top span{font-size:13px;color:#888}
  .cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px}
  .property{display:block;text-decoration:none;color:inherit;border:1px solid #ededed;border-radius:20px;overflow:hidden;background:white;transition:transform .2s,box-shadow .2s}
  .property[hidden]{display:none!important}.property:hover{transform:translateY(-3px);box-shadow:0 12px 30px #00000012}
  .property-image{height:210px;position:relative;background:#f1f1f1;overflow:hidden}
  .property-image img{width:100%;height:100%;object-fit:cover}
  .no-image{height:100%;display:grid;place-items:center;color:#888;font-size:13px}
  .status,.photo-count{position:absolute;top:12px;background:#fff;color:#151515;padding:7px 10px;border-radius:20px;font-size:11px;font-weight:700}
  .status{left:12px}.photo-count{right:12px}
  .property-info{padding:17px 18px 20px}
  .property-location{font-size:12px;color:#777;margin:0 0 8px}
  .property-info h2{font-size:16px;line-height:1.35;margin:0 0 14px;min-height:43px;font-weight:700}
  .price{font-size:22px;letter-spacing:-.035em}
  .features{display:flex;gap:12px;flex-wrap:wrap;font-size:12px;color:#666;margin:12px 0 16px}
  .details{display:flex;justify-content:space-between;border-top:1px solid #eee;padding-top:13px;font-weight:700;font-size:12px}
  .map-panel{height:min(76vh,800px);min-height:520px;position:sticky;top:100px;border-radius:22px;overflow:hidden;background:#f3f3f3}
  #map{height:100%;width:100%;z-index:0;filter:grayscale(1)}
  .map-note{position:absolute;bottom:15px;left:15px;right:15px;text-align:center;background:#ffffffec;padding:9px 12px;border-radius:12px;font-size:12px;color:#555;z-index:2}
  .empty{padding:40px 0;color:#777}
  .catalog-layout.grid-mode{grid-template-columns:1fr}.catalog-layout.grid-mode .map-panel{display:none}.catalog-layout.grid-mode .cards{grid-template-columns:repeat(4,minmax(0,1fr))}
  .mobile-toggle{display:none}
  @media(max-width:1150px){.catalog-layout{grid-template-columns:1fr 1fr}.cards{grid-template-columns:1fr}.catalog-layout.grid-mode .cards{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:760px){.catalog{padding:22px 15px 90px}.catalog-heading{align-items:start}.view-switch{display:none}.catalog-filters select{flex:1}.catalog-layout{display:block}.cards{grid-template-columns:1fr 1fr;gap:12px}.property-image{height:160px}.property-info{padding:13px}.property-info h2{font-size:14px}.price{font-size:18px}.map-panel{display:none;height:65vh;min-height:400px;position:relative;top:0}.catalog-layout.mobile-map .results{display:none}.catalog-layout.mobile-map .map-panel{display:block}.mobile-toggle{display:block;position:fixed;bottom:18px;left:50%;transform:translateX(-50%);z-index:20;background:#111;color:#fff;border:0;border-radius:28px;padding:14px 26px;box-shadow:0 8px 30px #0004;font-weight:700}.catalog-layout.grid-mode .cards{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:440px){.cards,.catalog-layout.grid-mode .cards{grid-template-columns:1fr}.property-image{height:220px}}
</style>
<script define:vars={{ locations: biens.map(b=>({id:String(b.id),ville:b.ville||'',postal:b.codePostal||'',lat:Number(b.latitude ?? b.lat),lng:Number(b.longitude ?? b.lng),prix:Number(b.prix||0),titre:b.titre||''})) }}>
  const search=document.getElementById('search'),type=document.getElementById('type'),budget=document.getElementById('budget'),cards=[...document.querySelectorAll('.property')],layout=document.getElementById('catalog-layout');
  let map,markers=[],visibleIds=new Set();
  const norm=s=>(s||'').toString().normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
  function filter(){
    const q=norm(search.value),t=type.value,b=Number(budget.value||0);let n=0;visibleIds=new Set();
    cards.forEach(c=>{const match=(!q||norm([c.dataset.ville,c.dataset.postal,c.dataset.title].join(' ')).includes(q))&&(!t||c.dataset.type===t)&&(!b||Number(c.dataset.prix)<=b);c.hidden=!match;if(match){n++;visibleIds.add(c.dataset.id)}});
    document.getElementById('count').textContent=n;document.getElementById('results-count').textContent=n+' résultats';document.getElementById('empty').hidden=n!==0;
    markers.forEach(m=>{if(visibleIds.has(m.id))m.marker.addTo(map);else map.removeLayer(m.marker)});
  }
  [search,type,budget].forEach(el=>el.addEventListener('input',filter));
  document.getElementById('reset').addEventListener('click',()=>{search.value='';type.value='';budget.value='';filter()});
  document.getElementById('split-view').addEventListener('click',()=>{layout.classList.remove('grid-mode');document.getElementById('split-view').classList.add('selected');document.getElementById('grid-view').classList.remove('selected');setTimeout(()=>map?.invalidateSize(),100)});
  document.getElementById('grid-view').addEventListener('click',()=>{layout.classList.add('grid-mode');document.getElementById('grid-view').classList.add('selected');document.getElementById('split-view').classList.remove('selected')});
  document.getElementById('mobile-toggle').addEventListener('click',e=>{layout.classList.toggle('mobile-map');e.target.textContent=layout.classList.contains('mobile-map')?'Afficher les annonces':'Afficher la carte';setTimeout(()=>map?.invalidateSize(),100)});
  filter();
  async function initMap(){
    const note=document.getElementById('map-note');
    try{
      const css=document.createElement('link');css.rel='stylesheet';css.href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';document.head.append(css);
      await new Promise((resolve,reject)=>{const s=document.createElement('script');s.src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';s.onload=resolve;s.onerror=reject;document.head.append(s)});
      map=L.map('map',{scrollWheelZoom:false}).setView([46.10,6.15],10);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'&copy; OpenStreetMap contributors',maxZoom:19}).addTo(map);
      const points=locations.filter(p=>Number.isFinite(p.lat)&&Number.isFinite(p.lng)&&Math.abs(p.lat)<=90&&Math.abs(p.lng)<=180&&p.lat!==0&&p.lng!==0);
      const cityCache=new Map();
      for(const p of locations.filter(p=>!points.some(a=>a.id===p.id)&&p.ville)){
        const key=p.ville+' '+p.postal;
        if(!cityCache.has(key)){
          try{const r=await fetch('https://geo.api.gouv.fr/communes?nom='+encodeURIComponent(p.ville)+'&fields=centre,codesPostaux&format=json&geometry=centre');const list=await r.json();const found=list.find(x=>!p.postal||x.codesPostaux?.includes(p.postal))||list[0];cityCache.set(key,found?.centre?.coordinates||null)}catch{cityCache.set(key,null)}
        }
        const coords=cityCache.get(key);if(coords)points.push({...p,lat:coords[1],lng:coords[0]});
      }
      const bounds=[];
      for(const p of points){const marker=L.marker([p.lat,p.lng],{icon:L.divIcon({className:'',html:'<span style="display:block;background:#151515;color:#fff;border:2px solid #fff;border-radius:22px;padding:8px 12px;white-space:nowrap;font-size:12px;font-weight:700;box-shadow:0 2px 8px #0003">'+Math.round(p.prix).toLocaleString('fr-FR')+' €</span>',iconSize:[110,36],iconAnchor:[55,18]})});marker.bindPopup('<strong>'+String(p.titre).replace(/[&<>"']/g,'')+'</strong><br><a href="/biens/'+encodeURIComponent(p.id)+'">Voir le bien</a>');markers.push({id:p.id,marker});bounds.push([p.lat,p.lng])}
      if(bounds.length)map.fitBounds(bounds,{padding:[55,55],maxZoom:12});
      filter();
      note.textContent=points.length? 'Positions approximatives par commune lorsque l’adresse exacte est indisponible.':'Aucune localisation disponible pour ces biens.';
    }catch{note.textContent='La carte est momentanément indisponible. Les annonces restent accessibles.'}
  }
  initMap();
</script>