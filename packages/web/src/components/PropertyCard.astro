---
const { bien } = Astro.props;
const photo = bien.photos?.[0]?.url;
const badgeTexte = bien.vendu ? 'Vendu' : bien.etatTexte;
const badgeCouleur = bien.vendu ? '#e53935' : (bien.etatCouleur || '#43a047');
const badgeAnim = bien.vendu ? '' : (bien.etatAnim === 'blink' ? 'is-blink' : bien.etatAnim === 'pulse' ? 'is-pulse' : '');
const ICONS = {
	surface: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M4 9h5V4M20 15h-5v5"/></svg>',
	pieces: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M4 9h5v10M15 12h5"/></svg>',
	chambres: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8v11"/><path d="M3 16h18"/><path d="M21 19v-6a3 3 0 0 0-3-3H8v6"/><circle cx="7" cy="10.5" r="1.5"/></svg>',
};
---

<a href={`/biens/${bien.id}`} class="immo-card">
	<div class="immo-hero">
		{photo ? <img src={photo} alt={bien.titre} /> : null}
		<div class="immo-hero-shade immo-hero-shade-top"></div>
		<div class="immo-hero-shade immo-hero-shade-bottom"></div>

		{badgeTexte && (
			<div class="immo-badge">
				<span class:list={["immo-badge-dot", badgeAnim]} style={`--c:${badgeCouleur}`}></span>
				<span>{badgeTexte}</span>
			</div>
		)}

		<div class="immo-hero-top">
			<div class="immo-hero-name">{bien.titre}</div>
			{bien.ville && <div class="immo-hero-location">{bien.ville}{bien.codePostal ? ` - ${bien.codePostal}` : ''}</div>}
		</div>

		<div class="immo-hero-bottom">
			<div>
				<div class="immo-hero-price">{Number(bien.prix).toLocaleString('fr-FR')} €</div>
				{bien.pieces && <div class="immo-hero-pieces">{bien.pieces} pièce{bien.pieces > 1 ? 's' : ''}</div>}
			</div>
		</div>
	</div>

	<div class="immo-body">
		<div class="immo-type">
			{bien.type && <span>{bien.type}</span>}
			{bien.categorie && <span class:list={["immo-categorie", bien.categorie === 'neuf' ? 'is-neuf' : 'is-ancien']}>{bien.categorie === 'neuf' ? 'Neuf' : 'Ancien'}</span>}
		</div>
		<div class="immo-stats">
			{bien.surface && <span class="immo-stat"><span class="immo-ic" set:html={ICONS.surface} /> {bien.surface} m²</span>}
			{bien.pieces && <span class="immo-stat"><span class="immo-ic" set:html={ICONS.pieces} /> {bien.pieces} pièce{bien.pieces > 1 ? 's' : ''}</span>}
			{bien.chambres && <span class="immo-stat"><span class="immo-ic" set:html={ICONS.chambres} /> {bien.chambres} chambre{bien.chambres > 1 ? 's' : ''}</span>}
		</div>
	</div>
</a>
