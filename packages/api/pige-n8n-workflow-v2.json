{
  "name": "Pige Immo v2 - Leboncoin sync vers API",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7,13,20 * * *"
            }
          ]
        }
      },
      "id": "cron-lbc",
      "name": "Cron Leboncoin (3x/jour)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -600,
        -100
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { apifyInput: { \"immobilierCategory\": \"9\", \"location\": \"Saint-Julien-en-Genevois 74160\", \"seller_type\": \"private\", \"includePhone\": true, \"includeSeller\": false, \"adLimit\": 15 } } }];"
      },
      "id": "recherche-saint-ju",
      "name": "Recherche Saint JU",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -380,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/clearpath~leboncoin-immobilier/run-sync-get-dataset-items?token=TON_TOKEN_APIFY",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.apifyInput) }}",
        "options": {
          "timeout": 300000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "apify-run-sync",
      "name": "Lancer Actor + récupérer annonces",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -150,
        -100
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map(i => i.json).filter(j => j && Object.keys(j).length > 0);\nreturn [{ json: { source: 'leboncoin', items } }];"
      },
      "id": "wrap-payload",
      "name": "Envelopper payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        100,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://app.ambassadeur-immo.com/api/pige/ingest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Ingest-Secret",
              "value": "TON_PIGE_INGEST_SECRET"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "post-ingest",
      "name": "Envoyer à l'API Immo-App",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        330,
        -100
      ]
    }
  ],
  "connections": {
    "Cron Leboncoin (3x/jour)": {
      "main": [
        [
          {
            "node": "Recherche Saint JU",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Recherche Saint JU": {
      "main": [
        [
          {
            "node": "Lancer Actor + récupérer annonces",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lancer Actor + récupérer annonces": {
      "main": [
        [
          {
            "node": "Envelopper payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Envelopper payload": {
      "main": [
        [
          {
            "node": "Envoyer à l'API Immo-App",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}