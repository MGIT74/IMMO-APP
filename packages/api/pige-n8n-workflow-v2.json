{
  "name": "Pige Immo v2 - Leboncoin sync vers API",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7,13,20 * * *"
            }
          ]
        }
      },
      "id": "cron-lbc",
      "name": "Cron Leboncoin (3x/jour)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -600,
        -100
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const zones = [\n  { ville: 'Saint-Julien-en-Genevois', location: 'Saint-Julien-en-Genevois 74160' },\n  { ville: 'Annemasse', location: 'Annemasse 74100' },\n  { ville: 'Thonon-les-Bains', location: 'Thonon-les-Bains 74200' },\n  { ville: 'Evian-les-Bains', location: 'Evian-les-Bains 74500' },\n];\nreturn zones.map(z => ({ json: { ...z, apifyInput: { immobilierCategory: '9', location: z.location, seller_type: 'private', includePhone: true, includeSeller: false, adLimit: 50, email: 'TON_EMAIL_LBC', password: 'TON_MDP_LBC' } } }));"
      },
      "id": "zones-gen",
      "name": "Zones Chablais + Genevois",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -380,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/clearpath~leboncoin-immobilier/run-sync-get-dataset-items?token=TON_TOKEN_APIFY",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.apifyInput) }}",
        "options": {
          "timeout": 290000
        }
      },
      "id": "apify-run-sync",
      "name": "Lancer Actor Leboncoin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -150,
        -100
      ],
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const zoneVille = $('Zones Chablais + Genevois').item.json.ville;\nconst items = Array.isArray($json) ? $json : ($json.json ?? []);\nconst all = [];\nfor (const it of items) {\n  if (it && (it.list_id || it.url)) { it._zone = zoneVille; all.push(it); }\n}\nreturn [{ json: { source: 'leboncoin', items: all } }];"
      },
      "id": "wrap-payload",
      "name": "Envelopper payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        100,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://app.ambassadeur-immo.com/api/pige/ingest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Ingest-Secret",
              "value": "TON_PIGE_INGEST_SECRET"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "post-ingest",
      "name": "Envoyer à l'API Immo-App",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        330,
        -100
      ]
    }
  ],
  "connections": {
    "Cron Leboncoin (3x/jour)": {
      "main": [
        [
          {
            "node": "Zones Chablais + Genevois",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Zones Chablais + Genevois": {
      "main": [
        [
          {
            "node": "Lancer Actor Leboncoin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lancer Actor Leboncoin": {
      "main": [
        [
          {
            "node": "Envelopper payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Envelopper payload": {
      "main": [
        [
          {
            "node": "Envoyer à l'API Immo-App",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}